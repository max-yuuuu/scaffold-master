{
  "name": "@scaffold/ui",
  "version": "1.0.0",
  "description": "元搭后台物料包：统一组件、composable、工具与珍珠玻璃主题，平台与生成项目共用",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/ui": "./src/components/ui/index.ts",
    "./components/business": "./src/components/business/index.ts",
    "./components/*": "./src/components/*",
    "./composables/*": "./src/composables/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./data": "./src/data/index.ts",
    "./data/*": "./src/data/*.ts",
    "./types": "./src/types.ts",
    "./theme.css": "./src/styles/theme.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test --experimental-strip-types src/__tests__/*.test.ts src/utils/__tests__/*.test.ts"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "license": "MIT"
}
